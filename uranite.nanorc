## Syntax highlighting for Uranite

syntax uranite "\.urn$"
comment "#"

# Keywords
color brightblue "\<(public|private|protect|function|class|struct|interface|trait|enum|extends|implements|use|raises|raise|except|try|finally|final|Readonly|match|switch|case|async|await|return|package|import|from|as|delete|new|instanceof|subclassof|lambda|unit|backed|property|Meta|Callable|if|elif|else|for|while|break|continue|yield|pass|defer|export|extern|type|const|mut|ref|own|move|addressof|unsafe|virtual|override|abstract|static|native|and|or|not|is|in|where|self|parent|asm|volatile)\>"

# Built-in Types
color green "\<(I8|I16|I32|I64|U8|U16|U32|U64|F32|F64|Int|UInt|Float|Double|String|Boolean|Char|Byte|Bytes|Long|Integer|Void|NoneType|Object|Bool)\>"

# Literals
color brightred "\<(True|False|None)\>"
color brightred "\<0[xX][0-9a-fA-F_]+\>"
color brightred "\<0[bB][01_]+\>"
color brightred "\<0[oO][0-7_]+\>"
color brightred "\<[0-9][0-9_]*\.[0-9][0-9_]*\>"
color brightred "\<[0-9][0-9_]*\>"
color brightmagenta ""(\\.|[^"])*""
color brightmagenta "'(\\.|[^'])*'"

# Multi-line strings/comments (approximated)
color brightmagenta start="\"\"\"" end="\"\"\""
color brightmagenta start="'''" end="'''"

# Block comments
color cyan start="#\{" end="\}#"

# Comments and @tags
color cyan "(^|[[:space:]])#.*$"
color brightwhite "@[a-zA-Z]+"

# Symbols
color yellow "(\+|\-|\*|/|%|=|==|!=|<|>|<=|>=|=>|->|\?|:|;)"
